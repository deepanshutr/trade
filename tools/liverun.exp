#!/usr/bin/expect -f

if {$argc < 1} {
    puts stderr "usage: liverun.exp <logfile> \[soak-seconds\]"
    exit 2
}
set logfile [lindex $argv 0]
set soak 0
if {$argc >= 2} { set soak [lindex $argv 1] }
log_file -noappend $logfile

set esc \x1b
set desk "$env(HOME)/.local/bin/desk"

spawn /bin/sh -c {
    /bin/stty rows 30 columns 100 || exit 2
    saved=$(/bin/stty -g) || exit 2
    /bin/stty raw -echo || exit 2
    /bin/stty "$saved" || exit 2
    saved=$(/bin/stty -g) || exit 2
    "$1" XMR
    result=$?
    restored=$(/bin/stty -g) || exit 2
    if [ "$saved" != "$restored" ]; then
        printf 'BLOCKED: terminal settings were not restored\n' >&2
        if [ "$result" -ne 0 ]; then exit "$result"; fi
        exit 3
    fi
    printf 'terminal settings restored\n'
    exit "$result"
} desk-live-check $desk
set terminal $spawn_out(slave,name)
match_max 1000000

proc exit_with_child_status {fallback} {
    global spawn_id
    set result {}
    if {[catch {wait} result] || [llength $result] < 4 || [lindex $result 2] != 0} {
        exit 2
    }
    if {[lindex $result 4] eq "CHILDKILLED"} { exit 1 }
    set status [lindex $result 3]
    if {$status != 0} { exit $status }
    exit $fallback
}

proc wait_for {pattern seconds label {kind -ex}} {
    global spawn_id timeout
    set timeout $seconds
    expect {
        $kind $pattern { }
        timeout {
            puts stderr "BLOCKED: timed out after ${seconds}s waiting for: $label"
            exit 2
        }
        eof {
            puts stderr "BLOCKED: child exited early while waiting for: $label"
            exit_with_child_status 2
        }
    }
}

proc wait_for_size {cols rows} {
    global esc
    set cell [format {(?:[^\r\n%s]|%s\[[0-9;]*m)} $esc $esc]
    set pattern [format {%s\[H(?:%s*%s\[K\r\n){%d}%s%s\[K%s\[J} $esc $cell $esc [expr {$rows - 1}] [format {%-*s} $cols {View only}] $esc $esc]
    wait_for $pattern 10 "complete ${cols}x${rows} viewing frame" -re
}

proc select_target {} {
    global spawn_id timeout
    set selected {Target BTC buy limit $}
    set timeout 1
    for {set attempt 0} {$attempt < 20} {incr attempt} {
        send "9"
        expect {
            -ex $selected { return }
            timeout { }
            eof {
                puts stderr "BLOCKED: child exited while selecting a target"
                exit_with_child_status 2
            }
        }
    }
    puts stderr "BLOCKED: no selected target after waiting for public market metadata"
    exit 2
}

wait_for "connection active " 20 "active public connection"

send -- "${esc}\[B"
wait_for " 2s/col " 10 "zoom out to two seconds per column"
send -- "${esc}\[A"
wait_for " 1s/col " 10 "zoom back to one second per column"

wait_for "Hard 1 buy" 10 "the hard action row"
wait_for "Best 5 buy" 10 "the best action row"
send -- "${esc}\[200~1234567890${esc}\[201~"

send "c"
wait_for "1m/candle " 20 "candle mode at one minute"
send -- "${esc}\[A"
wait_for "1m/candle " 10 "candle mode stops at one minute"
send "c"
wait_for "1s/col " 10 "line mode restores its fine zoom"

send "mBTC\rmBTC\r"
wait_for "  BTC  " 15 "BTC market header"

select_target
send -- $esc
wait_for "Target 9 buy 0 sell | up/down zoom" 10 "target cancelled by lone Escape"

exec stty rows 29 columns 99 < $terminal
wait_for "need 100x30, have 99x29" 10 "undersized terminal message"
exec stty rows 30 columns 100 < $terminal
wait_for_size 100 30
wait_for "Hard 1 buy" 10 "controls after restoring terminal size"
select_target
send -- $esc
wait_for "Target 9 buy 0 sell | up/down zoom" 10 "target cancelled after terminal resize"

exec stty rows 40 columns 120 < $terminal
wait_for_size 120 40
select_target
send -- $esc
wait_for "Target 9 buy 0 sell | up/down zoom" 10 "target cancelled at wide size"
exec stty rows 30 columns 100 < $terminal
wait_for_size 100 30

if {$soak > 0} {
    set deadline [expr {[clock seconds] + $soak}]
    while {[clock seconds] < $deadline} {
        set remain [expr {$deadline - [clock seconds]}]
        if {$remain < 1} { set remain 1 }
        set timeout $remain
        expect {
            -ex "connection stale " {
                puts stderr "BLOCKED: stale connection during the soak window"
                exit 3
            }
            -ex "connection disconnected " {
                puts stderr "BLOCKED: disconnected connection during the soak window"
                exit 3
            }
            timeout { }
            eof {
                puts stderr "BLOCKED: child exited early during the soak window"
                exit_with_child_status 2
            }
        }
    }
    log_file
    log_file -a $logfile
    set fh [open $logfile r]
    set full [read $fh]
    close $fh
    set hmark "${esc}\[H"
    set kmark "${esc}\[K"
    set lastH [string last $hmark $full]
    if {$lastH < 0} {
        puts stderr "BLOCKED: no frame found in the log after the soak window"
        exit 3
    }
    set afterH [expr {$lastH + [string length $hmark]}]
    set kIdx [string first $kmark $full $afterH]
    if {$kIdx < 0} {
        puts stderr "BLOCKED: could not find the end of the last stats line"
        exit 3
    }
    set lastStats [string range $full $afterH [expr {$kIdx - 1}]]
    if {[string first "connection active " $lastStats] < 0} {
        puts stderr "BLOCKED: last connection state is not active: $lastStats"
        exit 3
    }
    if {[string first "bad" $lastStats] >= 0} {
        puts stderr "BLOCKED: last stats line after the soak contains bad: $lastStats"
        exit 3
    }
    puts "last stats line after soak: $lastStats"
}

send "q"
wait_for "${esc}\[?2004l${esc}\[?25h${esc}\[?1049l" 10 "terminal leave codes"
wait_for "terminal settings restored" 10 "terminal settings restored after q"
set timeout 10
expect {
    eof { }
    timeout {
        puts stderr "BLOCKED: timed out waiting for the process to exit after q"
        exit 2
    }
}
exit_with_child_status 0
